{
  "manifest_version": 3,
  "name": "Midnight Markers",
  "{{chrome}}.description": "A dark, polished bookmark library for Brave and Chrome.",
  "{{firefox}}.description": "A dark, polished bookmark library for Firefox.",
  "version": "0.2.3",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save to midnight-markers"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab/newtab.html"
  },
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  "{{chrome}}.background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "{{firefox}}.background": {
    "scripts": ["src/background/service-worker.ts"],
    "type": "module"
  },
  "{{firefox}}.browser_specific_settings": {
    "gecko": {
      "id": "midnight-markers@organiccat.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["websiteContent", "bookmarksInfo"]
      }
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "bookmarks", "alarms"],
  "host_permissions": ["https://openrouter.ai/*", "https://api.anthropic.com/*"]
}
